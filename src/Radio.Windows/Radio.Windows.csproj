<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/RadioMini.ico</ApplicationIcon>
    <AssemblyName>Radio</AssemblyName>
    <Version>0.3.6</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Radio.Core/Radio.Core.csproj" />
    <EmbeddedResource Include="Assets/RadioMini.ico" LogicalName="Radio.Windows.Assets.RadioMini.ico" />
  </ItemGroup>
  <!-- Pin runtime packages for Full releases without changing the Windows SDK pack. -->
  <Target Name="PinReleaseRuntimePackages" BeforeTargets="ProcessFrameworkReferences"
          Condition="'$(PortableRuntimeVersion)' != ''">
    <ItemGroup>
      <FrameworkReference Update="@(FrameworkReference)"
                          Condition="'%(FrameworkReference.Identity)' == 'Microsoft.NETCore.App' Or '%(FrameworkReference.Identity)' == 'Microsoft.WindowsDesktop.App.WindowsForms'"
                          RuntimeFrameworkVersion="$(PortableRuntimeVersion)" />
      <KnownAppHostPack Update="@(KnownAppHostPack)"
                        Condition="'%(KnownAppHostPack.Identity)' == 'Microsoft.NETCore.App' And '%(KnownAppHostPack.TargetFramework)' == 'net8.0'"
                        AppHostPackVersion="$(PortableRuntimeVersion)" />
      <KnownFrameworkReference Update="@(KnownFrameworkReference)"
          Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net8.0' And ('%(KnownFrameworkReference.Identity)' == 'Microsoft.NETCore.App' Or '%(KnownFrameworkReference.Identity)' == 'Microsoft.WindowsDesktop.App.WindowsForms' Or '%(KnownFrameworkReference.Identity)' == 'Microsoft.WindowsDesktop.App.WPF')"
          DefaultRuntimeFrameworkVersion="$(PortableRuntimeVersion)" LatestRuntimeFrameworkVersion="$(PortableRuntimeVersion)" />
      <KnownRuntimePack Update="@(KnownRuntimePack)"
          Condition="'%(KnownRuntimePack.TargetFramework)' == 'net8.0' And '%(KnownRuntimePack.Identity)' == 'Microsoft.WindowsDesktop.App'"
          LatestRuntimeFrameworkVersion="$(PortableRuntimeVersion)" />
    </ItemGroup>
  </Target>
</Project>
